# --- Server ---
PORT=3000

# --- API auth for YOUR hosted endpoint (not LinkedIn) ---
# Clients must send this as `x-api-key`. Leave blank to disable (not recommended in production).
API_KEY=

# Minimum milliseconds between outbound requests to LinkedIn (politeness/rate-limit guard).
LINKEDIN_MIN_REQUEST_INTERVAL_MS=1200

# How long (ms) to cache a resolved profile before re-fetching from LinkedIn.
PROFILE_CACHE_TTL_MS=3600000

# NOTE: LinkedIn session cookies (li_at / JSESSIONID) are no longer server
# config — callers pass them per-request in the POST /api/profile body.
# See README "API documentation".
