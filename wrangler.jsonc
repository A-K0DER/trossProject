{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkedin-profile-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-10",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "LinkedInApiContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LINKEDIN_API",
        "class_name": "LinkedInApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LinkedInApiContainer"]
    }
  ]
}
