{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "description": "A hosted API that reverse-engineers LinkedIn's internal Voyager API to return structured JSON for a given LinkedIn profile URL.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel deploy --prod"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vercel": "^59.9.1",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=18"
  }
}
